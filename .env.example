DISCORD_TOKEN=COLE_O_TOKEN_SECRETO_DO_BOT_AQUI
# IA local (sem chave de API externa). A porta 11434 deve continuar local.
OLLAMA_ENABLED=true
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT_MS=30000
OLLAMA_NUM_CTX=1024
OLLAMA_NUM_PREDICT=120
OLLAMA_NUM_THREAD=1
OLLAMA_KEEP_ALIVE=0
OLLAMA_MAX_CONCURRENT=1
OLLAMA_MAX_QUEUE=3
OLLAMA_USER_COOLDOWN_MS=15000
OLLAMA_GLOBAL_RPM=12
OLLAMA_MAX_PROMPT_CHARS=6000
OLLAMA_MAX_RESPONSE_CHARS=3000
API_KEY=GERE_UMA_CHAVE_ALEATORIA_LONGA
API_PORT=3001
API_HOST=127.0.0.1
DASHBOARD_PASSWORD=
# Opcional: URL pública se publicar o painel atrás de um proxy HTTPS.
DASHBOARD_PUBLIC_URL=
BOT_TIME_ZONE=America/Sao_Paulo
BOT_DEVELOPER_IDS=SEU_ID_DISCORD
# IDs dos cargos que podem usar comandos e painel administrativos (separados por vírgula).
BOT_ADMIN_ROLE_IDS=ID_DO_CARGO_ADMIN
# Mercado Pago: deixe vazio enquanto a integração estiver desativada.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# URL pública HTTPS que encaminha para /api/webhooks/mercado-pago no bot.
MERCADO_PAGO_WEBHOOK_URL=
# Payouts é independente do checkout e começa em modo de teste (sem repasses reais).
MERCADO_PAGO_PAYOUTS_ACCESS_TOKEN=
MERCADO_PAGO_PAYOUTS_TEST_MODE=true
MERCADO_PAGO_PAYOUTS_TEST_MAX_CENTS=1000
MERCADO_PAGO_PAYOUTS_PRIVATE_KEY_PATH=
MERCADO_PAGO_PAYOUTS_WEBHOOK_URL=
# PARTNER_PAYOUTS_ENCRYPTION_KEY é gerada e gravada no .env ao cadastrar a chave Pix pelo painel.
